#!/bin/sh
# >>> idlefx-companion >>>
# The dog looks around on a branch switch (`idlefx-companion hooks uninstall git` removes this block).
idlefx_status=$?
[ "$3" = 1 ] && command -v idlefx-companion >/dev/null 2>&1 && idlefx-companion poke curious >/dev/null 2>&1
(exit $idlefx_status)
